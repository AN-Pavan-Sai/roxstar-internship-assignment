datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum WheelStatus {
  INITIALIZED
  ACTIVE
  COMPLETED
  ABORTED
}

enum TransactionType {
  ENTRY_FEE
  WINNINGS
  ADMIN_REWARD
  REFUND
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  role         Role          @default(USER)
  coins        Int           @default(1000)
  participants Participant[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model SystemConfig {
  key   String @id
  value String
}

model SpinWheel {
  id           String        @id @default(uuid())
  status       WheelStatus   @default(INITIALIZED)
  entryFee     Int
  winnerPool   Int           @default(0)
  adminPool    Int           @default(0)
  appPool      Int           @default(0)
  winnerId     String?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  participants Participant[]
}

model Participant {
  id           String    @id @default(uuid())
  spinWheelId  String
  spinWheel    SpinWheel @relation(fields: [spinWheelId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  isEliminated Boolean   @default(false)
  eliminatedAt DateTime?

  @@unique([spinWheelId, userId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Int
  type        TransactionType
  referenceId String?
  createdAt   DateTime        @default(now())
}